# Oversized Bench campaign server. Copy to .env and fill in.
# With the three SHOPIFY_* values empty the app runs in DEMO MODE: no store,
# fake DEMO- codes, magic links printed to the console, local demo admin.

PORT=4000
NODE_ENV=development
# Public https origin of this server, on a subdomain of the shop's own domain,
# e.g. https://play.oversizedstudios.com (see README: "Cookies").
APP_URL=http://localhost:4000
# Storefront origins that may call the API with credentials (comma separated).
STOREFRONT_ORIGINS=https://www.oversizedstudios.com,https://oversizedstudios.com
# Where the "confirm your e-mail" page links back to.
STOREFRONT_RETURN_URL=https://www.oversizedstudios.com/pages/bench

# 32+ random bytes. Hashes session tokens, signs customer assertions and
# encrypts the stored Admin API token. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=

DATABASE_FILE=./data/campaign.sqlite
SESSION_TTL_DAYS=180

# From the app's page in the Shopify Dev Dashboard / Partner Dashboard.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# The store's myshopify domain, e.g. oversized-studios.myshopify.com
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_API_VERSION=2026-07
# Optional: a pre-issued offline Admin API token. Normally left empty; the
# token is obtained by token exchange the first time the embedded admin opens.
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Outgoing mail for magic links, e.g. smtps://user:pass@smtp.example.com:465
SMTP_URL=
MAIL_FROM=Oversized Studios <no-reply@oversizedstudios.com>
MAGIC_LINK_TTL_MINUTES=20

# DEMO_MODE=1 forces demo mode even with credentials. Demo mode refuses to
# start with NODE_ENV=production unless ALLOW_DEMO_IN_PRODUCTION=1.
DEMO_MODE=
# Express "trust proxy" setting (hop count or subnet) for correct client IPs.
TRUST_PROXY=
