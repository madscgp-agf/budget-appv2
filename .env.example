# Copy to .env and fill in. Everything here has a working development default
# except the Google credentials, which you get from the Google Cloud console.

PORT=3000
APP_URL=http://localhost:3000
NODE_ENV=development

# Signing key for session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_TTL_SECONDS=604800

# SQLite database location.
DATABASE_FILE=./data/budget.sqlite

# Google sign-in -- https://console.cloud.google.com/apis/credentials
# Create an "OAuth client ID" of type "Web application".
#   Authorised JavaScript origin:  http://localhost:3000
#   Authorised redirect URI:       http://localhost:3000/api/auth/google/callback
# The client ID alone enables the Google button; the secret also enables the
# server-side redirect flow used as a fallback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# How long a QR / invite code is valid, in seconds.
CONNECT_TOKEN_TTL_SECONDS=900

DEFAULT_CURRENCY=USD
